{
  "type": "object",
  "properties": {
    "ENV": {
      "type": "string",
      "description": "运行环境：local、staging、prod。决定前端入口 HTML"
    },
    "IS_TEST": {
      "type": "boolean",
      "default": false,
      "description": "为 true 时消息不真正发送，账号接口返回验证码和重置令牌"
    },
    "ORIGIN": {
      "type": "string",
      "default": "http://localhost:3049",
      "description": "站点对外源地址，用于重置密码链接；也是 OIDC 的 origin"
    },
    "OIDC_KEY_SECRET": {
      "type": "string",
      "description": "OIDC 签名私钥加密密钥（独立部署作为 IdP 时使用）；部署在应用中心时以 central 模式运行，无需配置"
    },
    "ALISMTP_USER": {
      "type": "string",
      "description": "发信邮箱账号"
    },
    "ALISMTP_PASSWORD": {
      "type": "string",
      "description": "发信邮箱密码"
    },
    "ALISMTP_ENDPOINT": {
      "type": "string",
      "description": "SMTP 主机"
    },
    "OSS_REGION": {
      "type": "string",
      "description": "阿里云 OSS 区域（如 oss-cn-shanghai）。OSS_* 四项都填写时上传文件存 OSS，否则存本地"
    },
    "OSS_BUCKET": {
      "type": "string",
      "description": "阿里云 OSS Bucket"
    },
    "OSS_ACCESS_KEY_ID": {
      "type": "string",
      "description": "阿里云 OSS AccessKey ID"
    },
    "OSS_ACCESS_KEY_SECRET": {
      "type": "string",
      "description": "阿里云 OSS AccessKey Secret"
    },
    "APP_ID": {
      "type": "number",
      "description": "腾讯云 TRTC SDKAppID。与 APP_SECRET 都填写时开启聊天里的语音、视频通话"
    },
    "APP_SECRET": {
      "type": "string",
      "description": "腾讯云 TRTC 密钥"
    }
  },
  "required": []
}
