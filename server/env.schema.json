{
  "type": "object",
  "properties": {
    "ENV": {
      "type": "string",
      "description": "运行环境：local、staging、prod。决定前端入口 HTML"
    },
    "IS_TEST": {
      "type": "boolean",
      "default": false,
      "description": "为 true 时消息不真正发送，账号接口返回验证码和重置令牌"
    },
    "ORIGIN": {
      "type": "string",
      "description": "站点对外源地址，用于重置密码链接"
    },
    "ALISMTP_USER": {
      "type": "string",
      "description": "发信邮箱账号"
    },
    "ALISMTP_PASSWORD": {
      "type": "string",
      "description": "发信邮箱密码"
    },
    "ALISMTP_ENDPOINT": {
      "type": "string",
      "description": "SMTP 主机"
    }
  },
  "required": []
}
